{
  "name": "PeduliBersama - Telegram Bot (Simplified)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "node-telegram-trigger-simple",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://donasi-platform.vercel.app/bot_api.php?action=chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.message?.text || $json.callback_query?.data || '' }}\",\n  \"chat_id\": \"{{ $json.message?.chat?.id || $json.callback_query?.message?.chat?.id || $json.callback_query?.from?.id || '' }}\",\n  \"from_name\": \"{{ $json.message?.from?.first_name || $json.callback_query?.from?.first_name || 'Sahabat' }}\"\n}",
        "options": {}
      },
      "id": "node-http-bridge-simple",
      "name": "API Website PeduliBersama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.reply_text }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "={{ JSON.stringify($json.reply_markup) }}"
        }
      },
      "id": "node-telegram-send-simple",
      "name": "Kirim Balasan ke Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        740,
        300
      ]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "API Website PeduliBersama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "API Website PeduliBersama": {
      "main": [
        [
          {
            "node": "Kirim Balasan ke Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
